# Forge Labels — environment template
#
# EVERYTHING IS OPTIONAL. With no variables set, the app runs in local demo
# mode: the full editor works and projects persist in the browser.
# Add the Supabase pair to enable accounts + cloud sync; add the Stripe trio
# to enable subscriptions. Full walkthrough: docs/SETUP.md

# --- Supabase (cloud mode) --------------------------------------------------
# Project settings → API. The anon key is safe to expose (RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose or commit. Used by Stripe webhook/billing routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (billing) --------------------------------------------------------
# Server-only secret key + the webhook signing secret for /api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to "1" once Stripe is configured so the UI offers checkout.
NEXT_PUBLIC_STRIPE_ENABLED=

# --- Auth extras --------------------------------------------------------------
# Set to "1" AFTER configuring the Apple provider in Supabase (needs an Apple
# Developer account) — it adds "Sign in with Apple" beside Google.
NEXT_PUBLIC_AUTH_APPLE=

# --- AI assistant (editor) ---------------------------------------------------
# Server-only. Setting a Claude API key activates the editor's AI assistant
# tab; without it the tab explains how to enable it.
ANTHROPIC_API_KEY=
# Optional overrides: model id and reasoning effort (low|medium|high|max).
ASSISTANT_MODEL=
ASSISTANT_EFFORT=
